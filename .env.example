# ── SortSmart Cloud Environment Variables ─────────────────────────────────────
# Copy this to .env locally OR paste each value into your Render/Railway dashboard.
# NEVER commit the actual .env file to git.

# ── AI Provider ───────────────────────────────────────────────────────────────
# Cloud uses Groq (Ollama only works locally).
# Get a free Groq key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
SORTSMART_PROVIDER=groq

# Optional: Anthropic key for photo mode on cloud
# Get at: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key_here
# SORTSMART_PROVIDER=anthropic

# ── Security ──────────────────────────────────────────────────────────────────
# Set APP_PASSWORD to protect your cloud app with a password.
# Leave blank to allow open access (not recommended for public cloud).
APP_USERNAME=sortsmart
APP_PASSWORD=your_strong_password_here
